{
  "name": "agent-kernel-mcp",
  "version": "0.3.0",
  "description": "Agent Kernel: DSH Header + outbound WSS + MCP; CLI runner for Claude/Aider/OpenCode.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-kernel-mcp": "./dist/mcp/index.js",
    "agent-kernel-runner": "./dist/runner/runner/index.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.runner.json",
    "build:mcp": "tsc -p tsconfig.json",
    "build:runner": "tsc -p tsconfig.runner.json",
    "build:dsh": "tsc -p tsconfig.host.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.runner.json --noEmit",
    "start": "node dist/mcp/index.js",
    "start:runner": "node dist/runner/runner/index.js",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr4iser90/agent-kernel-mcp.git"
  },
  "keywords": [
    "mcp",
    "agent-kernel",
    "deepseek-harness",
    "dsh-plugin",
    "claude-code",
    "aider",
    "opencode"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-workspace": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/dsh-session": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.18.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}
