{
  "name": "agent-kernel-mcp",
  "version": "0.1.0",
  "description": "Stdio MCP server for the agent-kernel control-plane HTTP API (VS Code / Cursor / DeepSeek Harness).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-kernel-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr4iser90/agent-kernel-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/fr4iser90/agent-kernel-mcp/issues"
  },
  "homepage": "https://github.com/fr4iser90/agent-kernel-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-kernel",
    "deepseek-harness",
    "vscode"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
