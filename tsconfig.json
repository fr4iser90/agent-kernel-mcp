{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/mcp",
    "rootDir": "src/mcp",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "skipLibCheck": true
  },
  "include": ["src/mcp/**/*.ts"]
}
